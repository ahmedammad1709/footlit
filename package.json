{
  "name": "footlit",
  "version": "0.1.0",
  "private": true,
  "description": "GitHub, with stage lighting. A browser extension that gives GitHub events a proper entrance.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "icons": "node scripts/make-icons.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test-e2e.mjs && node scripts/test-themes.mjs",
    "test:detectors": "node scripts/test-e2e.mjs",
    "test:themes": "node scripts/test-themes.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/league-gothic": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@types/chrome": "^0.3.5",
    "esbuild": "^0.28.2",
    "puppeteer-core": "^25.13.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2"
  }
}
