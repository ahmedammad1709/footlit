{
  "manifest_version": 3,
  "name": "Footlit",
  "short_name": "Footlit",
  "version": "1.0.2",
  "description": "Celebrate GitHub moments with themed full-screen animations: merges, passing checks, releases, deploys and more.",
  "minimum_chrome_version": "111",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "Footlit",
    "default_popup": "popup/popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "options_page": "options/options.html",
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["https://github.com/*"], "js": ["content.js"], "run_at": "document_start" }],
  "permissions": ["storage"],
  "host_permissions": ["https://github.com/*"]
}
