{
  "name": "footlit",
  "version": "1.0.2",
  "license": "MIT",
  "private": true,
  "description": "GitHub, with stage lighting. A browser extension that gives GitHub events a proper entrance.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "icons": "node scripts/make-icons.mjs",
    "typecheck": "tsc --noEmit",
    "build:firefox": "node scripts/build.mjs --firefox",
    "build:site": "node scripts/package.mjs && node site/scripts/prep.mjs && npm --prefix site run build",
    "package": "node scripts/package.mjs",
    "store-assets": "node scripts/store-assets.mjs",
    "site-assets": "node scripts/site-assets.mjs",
    "test": "node scripts/build.mjs && node scripts/test-stats.mjs && node scripts/test-e2e.mjs && node scripts/test-themes.mjs",
    "test:detectors": "node scripts/test-e2e.mjs",
    "test:themes": "node scripts/test-themes.mjs",
    "test:firefox": "node scripts/test-firefox.mjs",
    "package:source": "node scripts/package-source.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/league-gothic": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@types/chrome": "^0.3.5",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "puppeteer-core": "^25.13.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2"
  }
}
